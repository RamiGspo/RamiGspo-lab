@@ -548,6 +573,38 @@ _ensure-venv:
 _ensure-venv:
     if (-not (Test-Path "{{ venv }}")) { Write-Host "Python venv not found. Run: just setup"; exit 1 }
 
+# Fail fast on a too-old Rust or missing Linux system libraries, instead of
+# minutes into the cargo build
+[private, unix]
+_check-tauri-deps:
+    #!/usr/bin/env bash
+    set -euo pipefail
+
+    if ! command -v rustc >/dev/null 2>&1; then
+        echo "ERROR: Rust not found. Install it from https://rustup.rs"
+        exit 1
+    fi
+    have="$(rustc --version | awk '{print $2}')"
+    if [ "$(printf '%s\n%s\n' "{{ rust_min_version }}" "$have" | sort -V | head -n1)" != "{{ rust_min_version }}" ]; then
+        echo "ERROR: rustc $have is too old; Voicebox needs {{ rust_min_version }} or newer."
+        echo "  Update it with: rustup update stable"
+        exit 1
+    fi
+
+    if [ "$(uname)" = "Linux" ]; then
+        missing=()
+        for lib in webkit2gtk-4.1 gtk+-3.0 libsoup-3.0 librsvg-2.0 alsa; do
+            pkg-config --exists "$lib" 2>/dev/null || missing+=("$lib")
+        done
+        # appindicator is left out: the tray loads it with dlopen at runtime
+        if [ ${#missing[@]} -gt 0 ]; then
+            echo "ERROR: Missing system libraries for the Tauri build: ${missing[*]}"
+            echo "  Debian/Ubuntu: sudo apt install libwebkit2gtk-4.1-dev libgtk-3-dev libsoup-3.0-dev \\"
+            echo "                 librsvg2-dev libasound2-dev libayatana-appindicator3-dev patchelf"
+            exit 1
+        fi
+    fi
+
 # Ensure Tauri dev sidecar placeholder exists
 [private]
 _ensure-sidecar:
